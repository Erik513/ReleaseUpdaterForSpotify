<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    ErikwnkCore.AppLocalization is plain dictionary-based string lookup with
    no WinForms/UI dependency (it's explicitly designed to be usable outside
    a WinForms app too), so referencing it here to localize this layer's own
    status/log text doesn't pull any UI dependency into Core.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\ErikwnkCore\ErikwnkCore\ErikwnkCore.csproj" />
  </ItemGroup>

</Project>
