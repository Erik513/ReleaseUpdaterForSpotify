<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Release Updater for Spotify</AssemblyName>
    <RootNamespace>ReleaseUpdaterGui</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\Icons\SpotifyReleaseUpdater_48px.ico</ApplicationIcon>
    <Title>Release Updater for Spotify</Title>
    <Authors>Erik Wink</Authors>
    <Product>Release Updater for Spotify</Product>
    <Description>Automatically creates a Spotify playlist with new releases from followed artists.</Description>
    <Copyright>© 2026 Erik Wink</Copyright>
    <PackageIcon>SpotifyReleaseUpdater_48px.ico</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Pictures\SpotifyReleaseUpdater.png" />
    <None Remove="Assets\SpotifyReleaseUpdater.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\SpotifyReleaseUpdater_48px.ico" />
    <EmbeddedResource Include="Assets\Pictures\SpotifyReleaseUpdater.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CustomWFUI">
      <HintPath>..\lib\CustomWFUI\CustomWFUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    CustomWFUI.AppUpdater depends on GitHubSelfUpdater (and its net48 System.Text.Json
    polyfills) internally. Nothing in this project references those types directly, but
    they still need to ship next to CustomWFUI.dll for it to load at runtime.
  -->
  <ItemGroup>
    <None Include="..\lib\GitHubSelfUpdater\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Icons\SpotifyReleaseUpdater_48px.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReleaseUpdater.Core\ReleaseUpdater.Core.csproj" />
    <ProjectReference Include="..\ReleaseUpdater.Data\ReleaseUpdater.Data.csproj" />
    <ProjectReference Include="..\ReleaseUpdater.Spotify\ReleaseUpdater.Spotify.csproj" />
  </ItemGroup>

</Project>
